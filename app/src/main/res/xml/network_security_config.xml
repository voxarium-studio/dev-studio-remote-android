<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Platform TLS/hostname checks and system CAs only; no debug trust override. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
